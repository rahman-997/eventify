{
  "name": "eventify-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle.mjs",
    "pwa:check": "node scripts/check-pwa.mjs",
    "verify": "npm run build && npm run bundle:check && npm run pwa:check",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "express": "^5.1.0",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^1.33.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^7.0.2"
  }
}
