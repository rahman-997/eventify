NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://eventify:eventify@localhost:5432/eventify
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:5173
# Optional comma-separated allowlist when more than one browser origin is used.
# WEB_ORIGINS=http://localhost:5173,https://eventify.example.com
TRUST_PROXY_HOPS=1
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_GRACE_MS=10000
METRICS_ENABLED=true
CACHE_LIST_TTL_SECONDS=60
CACHE_DETAIL_TTL_SECONDS=120
CACHE_TTL_JITTER_PERCENT=10
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=300
EMAIL_MODE=log
# SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM=Eventify <no-reply@eventify.local>
OUTBOX_POLL_MS=2000
OUTBOX_IDLE_MAX_POLL_MS=15000
OUTBOX_RETENTION_DAYS=30
WORKER_HEARTBEAT_TTL_SECONDS=45
# Optional zero-cost hosting profile: run the BullMQ worker beside the API.
RUN_WORKER_IN_WEB_SERVICE=false
WORKER_PORT=3001
# Production startup migration retry policy. Keeps Prisma advisory locking enabled while staggering contending deploys.
MIGRATION_MAX_ATTEMPTS=6
MIGRATION_RETRY_DELAY_MS=5000
MIGRATION_RETRY_MAX_DELAY_MS=30000
MIGRATION_RETRY_JITTER_RATIO=0.2
